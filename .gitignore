# ─────────────────────────────────────────────────────────────
#  喵喵输入法 .gitignore
#  原则：仓库里只放源码和文档，任何二进制、生成物、个人数据都不进来
# ─────────────────────────────────────────────────────────────

# ── 个人隐私：绝对不要提交 ──────────────────────────────────
# cand_debug.log 是"你敲过的每一个字"的明文记录
cand_debug.log
# 这个空文件是调试日志的运行时开关
CatTextService.debug
# Rime 用户数据：个人词库(luna_pinyin.userdb)、学习记录，
# 以及文件名里带主机名和用户名的运行日志
rime_user/

# ── 第三方依赖：体积大且有各自的许可证，用文档说明获取方式 ──
rime_dl/
rime_data/

# ── 构建产物 ────────────────────────────────────────────────
_build/
installer_staging/
installer_manifest.txt
installer_res.rc
*.obj
*.lib
*.exp
*.res
*.pdb
*.ilk
*.dll
*.exe
*.apk
*.idsig

# ── 本地一次性脚本与产物 ────────────────────────────────────
merge.ps1
MeowIME_source_full.txt

# ── 本地测试脚手架（行为探针、离屏渲染、模拟用户目录）──────
_probe/

# ── 编辑器 / 系统 ───────────────────────────────────────────
.idea/
.vs/
.vscode/
*.user
*.suo
Thumbs.db
desktop.ini
